# TeamFrame environment template
# Copy to .env.local for development. Never commit real values.

# --- Supabase (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App URL ---
# Local dev example: http://localhost:3030
# Production example: https://your-domain.com
SITE_URL=

# --- Supabase (server-only) ---
# Service role key. Must NEVER be exposed to the browser or imported in client code.
SUPABASE_SERVICE_ROLE_KEY=

# CI-only service role key (must come from a separate CI Supabase project).
SUPABASE_SERVICE_ROLE_KEY_CI=

# Postgres connection string for db scripts.
# Prefer the Supabase Session pooler URI (port 5432) for long-lived script workloads.
# Transaction pooler mode (6543) is intended for short-lived stateless workloads
# and can break session-level behavior used by migration and reliability scripts.
# db:reset safety toggles:
# ALLOW_DESTRUCTIVE_RESET=true
# ALLOW_DESTRUCTIVE_RESET_IN_CI=true
# PROTECTED_DB_HOST_TOKENS=prod,production,live
# Example:
# postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# CI-only Postgres URL (must come from a separate CI Supabase project).
SUPABASE_DB_URL_CI=

# --- Supabase Management API (optional, server-only) ---
# Personal Access Token for the Supabase Management API / supabase CLI.
# Optional: used by `scripts/setup-staging-project.mjs` and by
# `npx supabase link` / `npx supabase config push` (the automated route for
# the auth settings in START_HERE.md step 6) when the CLI is not already
# logged in. Create one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Observability (Phase 1B / Wave 4) ---
# Sentry DSN for error reporting. Leave blank to keep Sentry dormant (safe for local dev).
# Server-side: SENTRY_DSN. Client-side: NEXT_PUBLIC_SENTRY_DSN (same value, both vars needed).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for build-time source-map upload. Leave blank locally/CI —
# builds stay green without it and no upload is attempted (next.config.ts gate).
SENTRY_AUTH_TOKEN=

# Sentry org and project slugs; only used when SENTRY_AUTH_TOKEN is set.
SENTRY_ORG=
SENTRY_PROJECT=

# Set to "true" to log Sentry init confirmation on boot (for runtime wiring verification only).
SENTRY_DEBUG=

# Secret for authenticating /api/health requests (returns subsystem detail when present).
# Generate: openssl rand -hex 32
HEALTHCHECK_SECRET=

# --- Landing page ---
# Address behind the "Request a pilot" CTA on the landing page (app/page.tsx).
# If unset, the CTA is not rendered (the page stays honest — no dead mailto).
# Example: pilot@yourcompany.com
NEXT_PUBLIC_PILOT_CONTACT_EMAIL=

# --- Admin bootstrap (used only while running `npm run seed:admin`) ---
# Password for the bootstrap admin. Pass it via the shell environment rather
# than saving it here; the seed script never prints it. Min 8 characters.
# SEED_ADMIN_PASSWORD=
